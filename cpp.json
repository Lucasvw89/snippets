    "bin_search": {
        "prefix": "bins",
        "body": [
            "// array is ${1:arr} || target is ${2:target}",
            "int bl = 0, br = $1.size() - 1;",
            "int bmid;",
            "while (bl <= br) {",
            "    bmid = bl + ((br - bl) >> 1);",
            "    if ($2 == $1[bmid]) { break; }",
            "    else if ($2 < $1[bmid]) br = bmid - 1;",
            "    else bl = bmid + 1;",
            "}"
        ],
        "description": "Binary Search"
    },
    "dsu": {
        "prefix": "DSU",
        "body": [
            "struct DSU {",
            "    int n, num_sets;",
            "    vector<int> p, sz;",
            "",
            "    DSU(int n) : n(n), num_sets(n), p(n), sz(n, 1) {",
            "        iota(p.begin(), p.end(), 0);",
            "    }",
            "",
            "    int find(int x) {",
            "        if (x == p[x]) return x;",
            "        return p[x] = find(p[x]);",
            "    }",
            "",
            "    bool unite(int a, int b) {",
            "        a = find(a); b = find(b);",
            "        if (a == b) return false;",
            "        if (sz[a] < sz[b]) swap(a, b);",
            "        p[b] = a;",
            "        sz[a] += sz[b];",
            "        num_sets--;",
            "        return true;",
            "    }",
            "",
            "    int size(int x) { return sz[find(x)]; }",
            "};"
        ],
        "description": "DSU"
    },
    "primes_sieve": {
        "prefix": "sieve",
        "body": [
            "int n_sieve = ${1:1e7 + 10};",
            "vector<bool> is_prime(n_sieve, true);",
            "is_prime[0] = is_prime[1] = false;",
            "for (int i = 2; i * i < n_sieve; i++) {",
            "    if (is_prime[i]) {",
            "        for (int j = i * i; j < n_sieve; j += i) is_prime[j] = false;",
            "    }",
            "}",
            "vector<ll> primes;",
            "for (int i = 2; i < n_sieve; i++) if (is_prime[i]) primes.push_back(i);"
        ],
        "description": "Sieve of Eratosthenes"
    },
    "modular_arithmetic": {
        "prefix": "ARITMOD",
        "body": [
            "const int MOD = 1e9 + 7;",
            "ll mod_add(ll a, ll b) { return (a + b) % MOD; }",
            "ll mod_sub(ll a, ll b) { return (a - b + MOD) % MOD; }",
            "ll mod_mul(ll a, ll b) { return (a * 1LL * b) % MOD; }",
            "",
            "ll fexp(ll base, ll exp) {",
            "    ll res = 1; base %= MOD;",
            "    while (exp > 0) {",
            "        if (exp % 2 == 1) res = mod_mul(res, base);",
            "        base = mod_mul(base, base);",
            "        exp /= 2;",
            "    }",
            "    return res;",
            "}",
            "",
            "ll inv(ll a) { return fexp(a, MOD - 2); }",
            "",
            "ll fact[${1:MAXN}], inv_fact[$1];",
            "void precompute_fact(int n) {",
            "    fact[0] = 1;",
            "    for (int i = 1; i <= n; i++) fact[i] = mod_mul(fact[i - 1], i);",
            "    inv_fact[n] = inv(fact[n]);",
            "    for (int i = n - 1; i >= 0; i--) inv_fact[i] = mod_mul(inv_fact[i + 1], i + 1);",
            "}",
            "",
            "ll nCr(int n, int r) {",
            "    if (r < 0 || r > n) return 0;",
            "    return mod_mul(fact[n], mod_mul(inv_fact[r], inv_fact[n - r]));",
            "}"
        ],
        "description": "Modular Arithmetic and Combinatorics"
    },
    "segtree": {
        "prefix": "segtree",
        "body": [
            "template <typename T>",
            "struct segtree {",
            "    vector<T> v; int n; T ID; T (*combine)(T, T);",
            "    segtree(const vector<T>& temp, T id, T (*func)(T, T))",
            "        : n(temp.size()), ID(id), combine(func) {",
            "        v.assign(2 * n, ID);",
            "        for (int i = 0; i < n; i++) v[n + i] = temp[i];",
            "        build();",
            "    }",
            "    void build() {",
            "        for (int i = n - 1; i > 0; --i) v[i] = combine(v[i<<1], v[i<<1|1]);",
            "    }",
            "    void update(int p, const T& value) {",
            "        for (v[p += n] = value; p >>= 1; ) v[p] = combine(v[p<<1], v[p<<1|1]);",
            "    }",
            "    T query(int l, int r) {",
            "        T resl = ID, resr = ID;",
            "        for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
            "            if (l&1) resl = combine(resl, v[l++]);",
            "            if (r&1) resr = combine(v[--r], resr);",
            "        }",
            "        return combine(resl, resr);",
            "    }",
            "};"
        ],
        "description": "THE SIGMATREE"
    },
    "fenwick_tree": {
        "prefix": "BIT",
        "body": [
            "struct BIT {",
            "    int n; vector<ll> tree;",
            "    BIT(int n) : n(n), tree(n + 1, 0) {}",
            "    void update(int i, ll val) {",
            "        for (++i; i <= n; i += i & -i) tree[i] += val;",
            "    }",
            "    ll query(int i) {",
            "        ll sum = 0; for (++i; i > 0; i -= i & -i) sum += tree[i];",
            "        return sum;",
            "    }",
            "    ll query(int l, int r) { return query(r) - query(l - 1); }",
            "};"
        ],
        "description": "Fenwick Tree (BIT)"
    },
    "hashing": {
        "prefix": "hash",
        "body": [
            "struct Hash {",
            "    static const ll MOD1 = 1e9 + 7, MOD2 = 1e9 + 9;",
            "    static const ll P1 = 31, P2 = 37;",
            "    vector<ll> h1, h2, p1, p2;",
            "    Hash(const string& s) : h1(s.size() + 1, 0), h2(s.size() + 1, 0),",
            "                            p1(s.size() + 1, 1), p2(s.size() + 1, 1) {",
            "        for (int i = 0; i < (int)s.size(); i++) {",
            "            h1[i + 1] = (h1[i] * P1 + s[i]) % MOD1;",
            "            h2[i + 1] = (h2[i] * P2 + s[i]) % MOD2;",
            "            p1[i + 1] = (p1[i] * P1) % MOD1;",
            "            p2[i + 1] = (p2[i] * P2) % MOD2;",
            "        }",
            "    }",
            "    pair<ll, ll> get(int l, int r) {",
            "        ll res1 = (h1[r + 1] - h1[l] * p1[r - l + 1] % MOD1 + MOD1) % MOD1;",
            "        ll res2 = (h2[r + 1] - h2[l] * p2[r - l + 1] % MOD2 + MOD2) % MOD2;",
            "        return {res1, res2};",
            "    }",
            "};"
        ],
        "description": "Double String Hashing"
    },
    "trie": {
        "prefix": "TRIE",
        "body": [
            "struct Trie {",
            "    vector<vector<int>> trie;",
            "    vector<int> count;",
            "    int nodes = 1;",
            "    Trie(int max_len) : trie(max_len, vector<int>(26, 0)), count(max_len, 0) {}",
            "    void insert(const string& s) {",
            "        int curr = 0;",
            "        for (char c : s) {",
            "            int v = c - 'a';",
            "            if (!trie[curr][v]) trie[curr][v] = nodes++;",
            "            curr = trie[curr][v];",
            "        }",
            "        count[curr]++;",
            "    }",
            "    bool search(const string& s) {",
            "        int curr = 0;",
            "        for (char c : s) {",
            "            int v = c - 'a';",
            "            if (!trie[curr][v]) return false;",
            "            curr = trie[curr][v];",
            "        }",
            "        return count[curr] > 0;",
            "    }",
            "};"
        ],
        "description": "TRIE"
    },
    "get_divisors": {
        "prefix": "DIVS",
        "body": [
            "vector<int> getdivisors(int n) {",
            "    vector<int> divisors;",
            "    for (int i = 1; i * i <= n; i++) {",
            "        if (n % i == 0) {",
            "            divisors.push_back(i);",
            "            if (i != n / i) divisors.push_back(n / i);",
            "        }",
            "    }",
            "    return divisors;",
            "}"
        ],
        "description": "Get all divisors of n"
    },
