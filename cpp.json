    "PolygonAreaFunction": {
        "prefix": "polyarea",
        "body": [
            "ld area(const vector<point> &P) {",
            "    ld result = 0.0;",
            "    int N = P.size();",
            "    for (int i = 0; i < N; i++) {",
            "        int next = (i + 1) % N;",
            "        result += (P[i].x * P[next].y - P[next].x * P[i].y);",
            "    }",
            "    return abs(result) / 2.0;",
            "}"
        ],
        "description": "Shoelace formula for polygon area"
    },
    "ccw": {
        "prefix": "ccw_snippet",
        "body": [
            "bool ccw(const point &a, const point &b, const point &c, bool accept_collinear = false) {",
            "    ll cross = (ll)(b.x - a.x) * (c.y - a.y) - (ll)(b.y - a.y) * (c.x - a.x);",
            "    return cross > 0 || (cross == 0 && accept_collinear);",
            "}"
        ],
        "description": "Counter-Clockwise orientation test"
    },
    "IsConvex": {
        "prefix": "isconvex",
        "body": [
            "bool is_convex(const vector<point> &P) {",
            "    int sz = (int)P.size();",
            "    if (sz <= 3) return false;",
            "    bool isLeft = ccw(P[0], P[1], P[2]);",
            "    for (int i = 1; i < sz; i++) {",
            "        if (ccw(P[i], P[(i+1)%sz], P[(i+2)%sz]) != isLeft) return false;",
            "    }",
            "    return true;",
            "}"
        ],
        "description": "Check if polygon is convex"
    }
